# Messaging: sendblue (default) or textbee (fallback)
MESSAGING_PROVIDER=sendblue

# Sendblue (iMessage)
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_WEBHOOK_SECRET=

# textbee (fallback)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Neon
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
NEON_API_KEY=
NEON_PROJECT_ID=

# Bright Data
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=

# Geocoding: sd_places table first, Nominatim fallback
NOMINATIM_USER_AGENT=care-navigator-hackathon

# Demo
DEMO_PHONE=

# Inbound mode: webhook (needs a public URL) or poll (no tunnel needed)
MESSAGING_INBOUND=webhook
POLL_INTERVAL_SECONDS=2
