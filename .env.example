# Messaging: sendblue (default) or textbee (fallback)
MESSAGING_PROVIDER=sendblue

# Sendblue (iMessage)
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_WEBHOOK_SECRET=

# textbee (fallback)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Neon
DATABASE_URL='postgresql://user:pass@host/dbname?sslmode=require&channel_binding=require'
# Separate Neon branch for tests (never production). tests/conftest.py resets it to seeds each run.
TEST_DATABASE_URL=
NEON_API_KEY=
NEON_PROJECT_ID=

# Bright Data
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_UNLOCKER_ZONE=

# Geocoding: sd_places table first, Nominatim fallback
NOMINATIM_USER_AGENT=care-navigator-hackathon

# Demo
DEMO_PHONE=

# Inbound mode: webhook (needs a public URL) or poll (no tunnel needed)
MESSAGING_INBOUND=webhook
POLL_INTERVAL_SECONDS=2
